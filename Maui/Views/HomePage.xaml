<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Diva2Maui.Controls"
             x:Class="Diva2Maui.Views.HomePage"
             Shell.NavBarIsVisible="False">
    <Grid Padding="5" RowDefinitions="Auto,*" RowSpacing="8">
        <controls:IdentityHeader x:Name="IdentityHeader" />
        <RefreshView x:Name="NotificationsRefreshView"
                     Grid.Row="1"
                     IsRefreshing="{Binding IsLoading}"
                     Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Notifications}"
                            SelectionMode="None">
                <CollectionView.Header>
                    <VerticalStackLayout Padding="8,4,8,12" Spacing="4">
                        <Label Text="Notifikace" FontSize="22" FontAttributes="Bold" />
                        <Label Text="{Binding StatusText}" TextColor="Gray" />
                    </VerticalStackLayout>
                </CollectionView.Header>
                <CollectionView.EmptyView>
                    <Label Text="Nemáte žádné notifikace."
                           Padding="8,18"
                           HorizontalTextAlignment="Center"
                           TextColor="Gray" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView Threshold="180">
                            <SwipeView.LeftItems>
                                <SwipeItems Mode="Execute">
                                    <SwipeItem Text="Smazat"
                                               BackgroundColor="#D9534F"
                                               CommandParameter="{Binding .}"
                                               Invoked="OnDismissSwipeInvoked" />
                                </SwipeItems>
                            </SwipeView.LeftItems>
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Execute">
                                    <SwipeItem Text="Smazat"
                                               BackgroundColor="#D9534F"
                                               CommandParameter="{Binding .}"
                                               Invoked="OnDismissSwipeInvoked" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border Margin="8,4"
                                    Padding="14"
                                    BackgroundColor="{Binding CardColor}"
                                    Stroke="#D9D9D9"
                                    StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding Title}"
                                           FontSize="16"
                                           FontAttributes="{Binding TitleFontAttributes}" />
                                    <Label Grid.Column="1"
                                           Text="●"
                                           TextColor="#1976D2"
                                           IsVisible="{Binding IsUnread}" />
                                    <Button Grid.Column="2"
                                            Text="×"
                                            FontSize="20"
                                            Padding="8,0"
                                            MinimumWidthRequest="36"
                                            MinimumHeightRequest="36"
                                            BackgroundColor="Transparent"
                                            TextColor="#666666"
                                            IsVisible="{Binding HasReaction}"
                                            SemanticProperties.Description="Skrýt oznámení"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnDismissClicked" />
                                </Grid>
                                <Label Text="{Binding Text}" LineBreakMode="WordWrap" />
                                <Label Text="{Binding LessonText}"
                                       IsVisible="{Binding HasLesson}"
                                       FontAttributes="Italic"
                                       TextColor="#555555" />
                                <Label Text="{Binding CreatedAtText}"
                                       FontSize="12"
                                       TextColor="Gray" />
                                <HorizontalStackLayout Spacing="10"
                                                       IsVisible="{Binding IsAwaitingReaction}">
                                    <Button Text="Mám zájem"
                                            BackgroundColor="#1FA64A"
                                            TextColor="White"
                                            IsEnabled="{Binding CanRespond}"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnAcceptClicked" />
                                    <Button Text="Nemám zájem"
                                            BackgroundColor="#D9534F"
                                            TextColor="White"
                                            IsEnabled="{Binding CanRespond}"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnDeclineClicked" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding ReactionText}"
                                       IsVisible="{Binding HasReaction}"
                                       FontAttributes="Bold"
                                       TextColor="#315B9D" />
                            </VerticalStackLayout>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
