<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Diva2Maui.Controls"
             x:Class="Diva2Maui.Views.LessonDetailPage"
             Title="Detail hodiny"
            >
    <Grid Padding="5" RowDefinitions="Auto,*,Auto" RowSpacing="8">
        <controls:IdentityHeader x:Name="IdentityHeader" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label x:Name="DateLabel" FontSize="22" FontAttributes="Bold" Grid.Column="0" Grid.Row="0"
                           LineBreakMode="WordWrap" VerticalTextAlignment="Center" />
                    <Label x:Name="TimeLabel" Grid.Column="1" Grid.Row="0" FontSize="30" FontAttributes="Bold"
                           TextColor="#512BD4" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />

                    <VerticalStackLayout x:Name="LectorContainer" Spacing="1" Grid.Column="0" Grid.Row="1">
                        <Label Text="Lektor" FontSize="12" TextColor="Gray" />
                        <Label x:Name="LectorLabel" FontSize="18" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                    <VerticalStackLayout x:Name="TypeContainer" Spacing="1" Grid.Column="1" Grid.Row="1">
                        <Label Text="Typ" FontSize="12" TextColor="Gray" />
                        <Label x:Name="TypeLabel" FontSize="18" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                    <VerticalStackLayout x:Name="CapacityContainer" Spacing="1" Grid.Column="0" Grid.Row="2">
                        <Label Text="Obsazenost" FontSize="12" TextColor="Gray" />
                        <Label x:Name="CapacityLabel" FontSize="18" />
                    </VerticalStackLayout>
                    <Button x:Name="ParticipantsButton" Grid.Column="1" Grid.Row="2"
                            Text="Zobrazit účastníky" Clicked="OnParticipantsClicked"
                            HorizontalOptions="Fill" VerticalOptions="Center" />
                    <VerticalStackLayout x:Name="NameContainer" Spacing="1" Grid.ColumnSpan="2" Grid.Row="3">
                        <Label Text="Název" FontSize="12" TextColor="Gray" />
                        <Label x:Name="NameLabel" FontSize="18" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>

                <Border Padding="12" Stroke="#D8DCE5">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Kredity a úhrada" FontSize="18" FontAttributes="Bold" />
                        <Label x:Name="TimeCreditsLabel" Text="Načítám kredity…" LineBreakMode="WordWrap" />
                        <Label x:Name="UnlimitedCreditsLabel" LineBreakMode="WordWrap" />
                        <Label x:Name="LessonPriceLabel" FontAttributes="Bold" />
                        <Label x:Name="TotalPriceLabel" FontAttributes="Bold" />
                        <Label x:Name="PaymentMessageLabel" IsVisible="False" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <Label x:Name="ReservationLabel" Margin="4,12,4,4"
                       FontSize="17" FontAttributes="Bold" LineBreakMode="WordWrap" />
                <VerticalStackLayout x:Name="NotificationResponseContainer" IsVisible="False" Spacing="8">
                    <Label Text="Uvolnilo se místo – potvrďte prosím svou účast."
                           FontAttributes="Bold" LineBreakMode="WordWrap" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0" Text="Potvrzuji" BackgroundColor="#1FA64A" TextColor="White"
                                Clicked="OnNotificationAcceptClicked" />
                        <Button Grid.Column="1" Text="Nemám zájem" BackgroundColor="#D9534F" TextColor="White"
                                Clicked="OnNotificationDeclineClicked" />
                    </Grid>
                </VerticalStackLayout>
                <Button x:Name="btnReservation" Text="Objednat" Clicked="OnReserveClicked" />
            </VerticalStackLayout>
        </ScrollView>
        <Button x:Name="btnCancelReserv" Grid.Row="2" Clicked="OnCancelReservationClicked"
                Margin="0,8,0,4" BackgroundColor="Transparent"
                BorderColor="DarkRed" BorderWidth="1" TextColor="DarkRed" />
    </Grid>
</ContentPage>
