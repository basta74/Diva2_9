<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Diva2Maui.Controls.IdentityHeader"
             x:Name="Header">
    <Grid ColumnDefinitions="*,Auto">
        <Label Text="{Binding DisplayName, Source={x:Reference Header}}"
               FontSize="20" FontAttributes="Bold"
               VerticalTextAlignment="Center" />
        <Label Grid.Column="1"
               Text="{Binding TenantName, Source={x:Reference Header}, StringFormat='{}{0}.diva2'}"
               TextColor="Gray" HorizontalTextAlignment="End"
               VerticalTextAlignment="Center" />
    </Grid>
</ContentView>
