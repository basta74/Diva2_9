@{
    ViewData["Title"] = "Účet je dočasně uzamčen";
    Layout = "~/Views/Shared/_LayoutAccount.cshtml";
}

<section class="card" aria-labelledby="lockout-title">
    <div class="card-body">
        <h1 class="card-title" id="lockout-title">Účet je dočasně uzamčen</h1>
        <p class="card-subtitle">Bylo zaznamenáno příliš mnoho neúspěšných pokusů o přihlášení.</p>
        <div class="alert alert-warning" role="alert">
            Počkejte několik minut a potom přihlášení zkuste znovu.
        </div>
        <a href="/Account/Login" class="btn btn-primary">Zpět k přihlášení</a>
    </div>
</section>
