@using Diva2Web.Models.Users
@model UserModelRegister
@{
    ViewData["Title"] = "Registrace";
    Layout = "~/Views/Shared/_LayoutAccount.cshtml";
}

@using (Html.BeginForm("Register", "Account", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <section class="account-form-card" aria-labelledby="register-title">
        <header class="account-form-header">
            <h1 id="register-title">Vytvoření účtu</h1>
            <p>Vyplňte své kontaktní údaje a zvolte si heslo.</p>
        </header>
        <div class="account-form-body">
            <input name="IsValid" type="hidden" value="@ViewData.ModelState.IsValid.ToString()" />
            <div asp-validation-summary="ModelOnly" role="alert"></div>
            <div class="account-form-grid">
                <div class="form-group">
                    <label asp-for="Jmeno"></label>
                    <input asp-for="Jmeno" class="form-control" autocomplete="given-name" />
                    <span asp-validation-for="Jmeno" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Prijmeni"></label>
                    <input asp-for="Prijmeni" class="form-control" autocomplete="family-name" />
                    <span asp-validation-for="Prijmeni" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" inputmode="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Telefon"></label>
                    <input asp-for="Telefon" class="form-control" autocomplete="tel" inputmode="tel" />
                    <span asp-validation-for="Telefon" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Ulice"></label>
                    <input asp-for="Ulice" class="form-control" autocomplete="street-address" />
                    <span asp-validation-for="Ulice" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Posta"></label>
                    <input asp-for="Posta" class="form-control" autocomplete="address-level2" />
                    <span asp-validation-for="Posta" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="NewPass"></label>
                    <input asp-for="NewPass" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="NewPass" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="NewPass2"></label>
                    <input asp-for="NewPass2" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="NewPass2" class="text-danger"></span>
                </div>
            </div>
            <div class="account-form-actions">
                <a href="/Account/Login" class="btn btn-outline-secondary">Zpět k přihlášení</a>
                <button type="submit" class="login-submit">Vytvořit účet</button>
            </div>
        </div>
    </section>
}

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
