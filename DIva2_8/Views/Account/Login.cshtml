@using Diva2Web.Models.Users
@model UserModelLogin
@{
    ViewData["Title"] = "Přihlášení";
    Layout = "~/Views/Shared/_LayoutAccount.cshtml";
}

@using (Html.BeginForm("Login", "Account", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <section class="login-card" aria-labelledby="login-title">
        <header class="login-header">
            <a class="login-brand" href="/Home/Index" aria-label="Zpět na úvodní stránku">Diva2</a>
            <h1 id="login-title">Vítejte zpět</h1>
            <p>Přihlaste se ke svému účtu.</p>
        </header>

        <div class="login-body">
            <div asp-validation-summary="ModelOnly" class="login-validation" role="alert"></div>

            @if (Model.Messages.Count > 0)
            {
                <div class="login-messages" role="alert">@Html.Raw(Model.MsgToString())</div>
            }

            @await Html.PartialAsync("~/Views/Shared/Account/_LoginFields.cshtml", Model)

            <button type="submit" class="login-submit">Přihlásit se</button>

            <button type="button" class="login-forgot-toggle" id="forgotPasswordToggle"
                    aria-expanded="false" aria-controls="forgotPasswordPanel">
                Zapomněli jste heslo?
            </button>

            <div class="login-forgot" id="forgotPasswordPanel" hidden>
                <label for="forgotEmail">E-mail pro obnovení hesla</label>
                <div class="login-forgot-row">
                    <input type="email" class="form-control login-input" id="forgotEmail"
                           placeholder="vas@email.cz" autocomplete="email" />
                    <button type="button" class="login-secondary-button" id="jsSendEmailBtn">Odeslat</button>
                </div>
            </div>

            <div id="messages" class="login-async-messages" aria-live="polite"></div>
        </div>

        <footer class="login-footer">
            <a href="/Home/Index">Zpět na úvod</a>
            <span aria-hidden="true">•</span>
            <a href="/Account/Register">Vytvořit účet</a>
            <span aria-hidden="true">•</span>
            <a href="/Home/Help">Nápověda</a>
        </footer>
    </section>
}
@section Scripts{
    <script>
        $(document).ready(function () {
            $('#forgotPasswordToggle').on('click', function () {
                const panel = document.getElementById('forgotPasswordPanel');
                const willOpen = panel.hidden;

                panel.hidden = !willOpen;
                this.setAttribute('aria-expanded', willOpen.toString());

                if (willOpen) {
                    document.getElementById('forgotEmail').focus();
                }
            });

            $(document).on('click', '#jsSendEmailBtn', function (event) {
                var email = $("#forgotEmail").val();

                if (!email) {
                    $('#messages').html('<div class="login-inline-error">Zadejte e-mailovou adresu.</div>');
                    return;
                }

                $.ajax({
                    method: "GET",
                    url: "/Account/SendForgotEmail/" + encodeURIComponent(email),
                }).done(function (data) {
                    $('#messages').html(writeMesssages(data.messages));
                });
            });
        });
    </script>
}

